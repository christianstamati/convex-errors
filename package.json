{
  "name": "convex-errors",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "examples/minimal",
      "examples/paraglide",
      "examples/monorepo/apps/*",
      "examples/monorepo/packages/*",
      "packages/*"
    ],
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
      "vite-plus": "1.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd examples/minimal dev",
    "build": "bun run --cwd packages/convex-errors build && bun run --cwd examples/minimal build && bun run --cwd examples/monorepo/apps/web build && bun run --cwd examples/paraglide build",
    "check": "vp check",
    "test": "vp run --filter './packages/*' test",
    "prepare": "vp config && bun run --cwd examples/paraglide compile",
    "dev:monorepo": "bun run --cwd examples/monorepo/apps/web dev",
    "dev:paraglide": "bun run --cwd examples/paraglide dev"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.4"
}
