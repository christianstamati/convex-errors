{
  "name": "@monorepo/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../../../../packages/convex-errors build && bun run --parallel dev:lib dev:web dev:backend",
    "dev:lib": "bun run --cwd ../../../../packages/convex-errors dev",
    "dev:web": "vp dev --port 5174",
    "dev:backend": "bun run --cwd ../../packages/backend dev",
    "build": "vp build"
  },
  "dependencies": {
    "@monorepo/backend": "workspace:*",
    "convex": "^1.48.0",
    "convex-errors": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
