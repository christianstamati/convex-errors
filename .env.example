# Environment variables for cloud-stack. Nothing here is a real secret.
# `bun run setup` writes the local values for you; this file only documents them.

# ── apps/web/.env.local (written by scripts/sync-env.ts) ───────────────────────
# Convex deployment URL the browser connects to. In production, `convex deploy`
# sets it during the deploy build (--cmd-url-env-var-name VITE_CONVEX_URL).
VITE_CONVEX_URL=http://127.0.0.1:3210

# ── packages/backend/.env.local (written by `convex dev`) ─────────────────────
# Which deployment the Convex CLI talks to, and its URLs.
CONVEX_DEPLOYMENT=anonymous:anonymous-backend
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211

# ── Cloudflare Workers Builds (Settings > Build > Variables and secrets) ──────
# CONVEX_DEPLOY_KEY          Secret. Convex production deploy key, used for builds of main
# CONVEX_PREVIEW_DEPLOY_KEY  Secret. Convex preview deploy key, used for every other branch
# BUN_VERSION                1.4.4, so the build uses the same Bun as the repo
# SKIP_DEPENDENCY_INSTALL    1. scripts/cloudflare-build.ts installs from the repo root instead
