{
  "name": "@cs-stack/convex-errors",
  "version": "0.1.0",
  "description": "One consistent, typed way to define, throw, catch, show and translate errors in Convex apps.",
  "keywords": [
    "convex",
    "errors",
    "i18n"
  ],
  "homepage": "https://github.com/christianstamati/convex-errors/tree/main/packages/convex-errors#readme",
  "bugs": "https://github.com/christianstamati/convex-errors/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianstamati/convex-errors.git",
    "directory": "packages/convex-errors"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@convex-errors/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "dev": "tsdown --watch",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "example": "bun --conditions=@convex-errors/source example/demo.ts"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "convex-test": "^0.0.65",
    "sonner": "^2.0.8",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "convex": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
