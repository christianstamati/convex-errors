{
  "name": "convex-errors",
  "version": "0.0.0",
  "description": "One consistent, typed way to define, throw, catch, show and translate errors in Convex apps.",
  "keywords": [
    "convex",
    "errors",
    "i18n"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "convex-test": "^0.0.65",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "convex": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
